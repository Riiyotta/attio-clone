      "id": "showcase",
      "type": "features.platform-showcase",
      "content": {
        "intro": {
          "lead": "A single workspace across every pipeline.",
          "continuation": "Keep records, tasks and notes together in one place so each teammate works off a shared view."
        },
        "articles": [
          {
            "navLabel": "Spark interest",
            "title": "Find new demand early. Spot promising accounts as they appear, enrich them on arrival and route them to the right owner.",
            "visual": {
              "assetRole": "product.reference-mock",
              "assetRef": "ref:src/components/PlatformShowcase.jsx#article-1",
              "alt": "Routing rules"
            },
            "subCards": [
              {
                "title": "Leads enriched promptly",
                "body": "New companies and people are filled in with helpful details the moment they arrive.",
                "visual": {
                  "assetRole": "product.reference-mock",
                  "assetRef": "ref:src/components/PlatformShowcase.jsx#sub-1a",
                  "alt": "Enrichment card"
                }
              },
              {
                "title": "Route to the right rep",
                "body": "Simple rules send every new account to the one person best placed to help.",
                "visual": {
                  "assetRole": "product.reference-mock",
                  "assetRef": "ref:src/components/PlatformShowcase.jsx#sub-1b",
                  "alt": "Assignment rule"
                }
              }
            ]
          },
          {
            "navLabel": "Qualify leads",
            "title": "Qualify every lead quickly. Score new interest, check fit against your own rules and hand off the best leads fast.",
            "visual": {
              "assetRole": "product.reference-mock",
              "assetRef": "ref:src/components/PlatformShowcase.jsx#article-2",
              "alt": "Lead scoring"
            }
          },
          {
            "navLabel": "Run your playbook",
            "title": "Run a repeatable plan daily. Turn your best habits into shared sequences that guide each rep through the next steps.",
            "visual": {
              "assetRole": "product.reference-mock",
              "assetRef": "ref:src/components/PlatformShowcase.jsx#article-3",
              "alt": "Sequence editor"
            }
          },
          {
            "navLabel": "Forecast results",
            "title": "Forecast the quarter with certainty Roll up pipeline by stage, owner and segment, then compare commits against targets as weeks go past.",
            "visual": {
              "assetRole": "product.reference-mock",
              "assetRef": "ref:src/components/PlatformShowcase.jsx#article-4",
              "alt": "Forecast view"
            }
          },
          {
            "navLabel": "Grow the accounts",
            "title": "Keep and grow accounts. Track usage and health signals to step in early and expand the right accounts.",
            "visual": {
              "assetRole": "product.reference-mock",
              "assetRef": "ref:src/components/PlatformShowcase.jsx#article-5",
              "alt": "Health scores"
            }
          }
